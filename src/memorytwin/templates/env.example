# Memory Twin - Configuration
# ============================
# Copy this file to .env and fill in your API keys.

# =============================================================================
# LLM PROVIDER - choose ONE of the options below
# =============================================================================

# Option A: OpenRouter (recommended - access to many free models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
LLM_PROVIDER=openrouter
LLM_MODEL=amazon/nova-2-lite-v1:free

# Option B: Google Gemini
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your_google_api_key_here
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash

# =============================================================================
# OPTIONAL SETTINGS (defaults shown)
# =============================================================================

# LLM temperature for structuring captures (0.0 = deterministic, 1.0 = creative)
# LLM_TEMPERATURE=0.3

# Local embedding model (sentence-transformers, runs on CPU, no API cost)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage (paths are relative to the directory where `mt` runs)
# CHROMA_PERSIST_DIR=./data/chroma
# SQLITE_DB_PATH=./data/memory.db

# Web UI (`mt oraculo`). Bound to localhost by default because it can delete episodes.
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
# GRADIO_SHARE=false

# Observability with Langfuse (requires: pip install "memorytwin[observability]")
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
